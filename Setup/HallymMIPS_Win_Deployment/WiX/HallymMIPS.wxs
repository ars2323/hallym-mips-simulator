<?xml version="1.0" encoding="utf-8"?>
<!-- Hallym MIPS Simulator installer (WiX Toolset v3).  See ../README.md.

     Built by tools/package-msi.ps1, which passes
       ProductVersion  EDU_VERSION from QtSpim/edu/edu_version.h (MAJOR.MINOR.PATCH)
       GuideFile       the Korean guide's file name in that folder (PDF in CI)
       StageDir        the staged zip folder; its files are harvested into
                       the component group AppFiles (heat) -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Hallym MIPS Simulator" Manufacturer="AIAC Lab, Hallym University"
           Language="1033" Codepage="1252" Version="$(var.ProductVersion)"
           UpgradeCode="BF8A162B-8D89-43B4-9166-46E6EFEF30A9">
    <Package InstallerVersion="301" Compressed="yes" InstallScope="perMachine"
             Platform="x64" Keywords="Installer"
             Description="Hallym MIPS Simulator $(var.ProductVersion) installer"
             Comments="MIPS32 simulator for Hallym University courses, based on QtSpim. SPIM is Copyright (c) James R. Larus." />

    <!-- A newer Hallym MIPS Simulator replaces an older one.  Standard QtSpim
         and QtSpim-Edu have different UpgradeCodes and are never looked for. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Hallym MIPS Simulator is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="HallymMIPS.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="HallymMIPS.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ars2323/hallym-mips-simulator" />

    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Hallym MIPS Simulator" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="EduProgramMenuDir" Name="Hallym MIPS Simulator">
          <Component Id="EduStartMenu" Guid="5B0E1C0E-6E0B-4A55-9F6B-3D6E5A0B7C11" Win64="yes">
            <Shortcut Id="EduStartMenuApp" Name="Hallym MIPS Simulator"
                      Description="MIPS32 simulator for Hallym University courses"
                      Target="[INSTALLFOLDER]HallymMIPS.exe"
                      WorkingDirectory="INSTALLFOLDER" Icon="HallymMIPS.ico" />
            <Shortcut Id="EduStartMenuGuide" Name="User Guide"
                      Target="[INSTALLFOLDER]$(var.GuideFile)"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="EduProgramMenuDir" On="uninstall" />
            <!-- Key path of the shortcuts.  NOT under Software\HallymMIPS,
                 where the program keeps its settings. -->
            <RegistryValue Root="HKCU" Key="Software\HallymMIPS-Installer"
                           Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Hallym MIPS Simulator" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="EduStartMenu" />
    </Feature>
  </Product>
</Wix>
