{
  "name": "hallym-mips-simulator-electron",
  "version": "0.0.0",
  "private": true,
  "description": "Spike: the SPIM core as a Node addon, checked against the Qt build's output",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "node-gyp rebuild --directory native",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:mutants": "node tools/mutants.ts",
    "spike": "node tests/spike/check-text.js && node tests/spike/check-decoder.ts",
    "gen:op-table": "node tools/gen-op-table.ts",
    "goldens:default": "node tools/capture-default-goldens.ts",
    "build:electron": "node tools/build-electron.ts",
    "electron": "node tools/electron.ts",
    "smoke:electron": "node tools/electron.ts --smoke build/wiring-check.png",
    "mockups": "node tools/electron.ts --mockups docs/mockups"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "node-gyp": "^13.0.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
